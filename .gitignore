# Build artifacts (produced by scripts/build.sh)
/build/

# Static-analysis raw output. The summarised .log files and triage notes
# under analysis/ ARE committed; bulky/binary derivatives are ignored.
/analysis/raw/
/analysis/scanbuild/
/analysis/infer/
/analysis/*.profraw
/analysis/*.profdata

# Vendored installers (~5 GB total) — the giant ones are not in git.
# README.md inside is committed and lists download URLs + checksums;
# setup-lion.sh expects them locally.
/prereqs/*
!/prereqs/README.md
# Graphics Tools (1.5 MB Tiger-vintage OpenGL Profiler etc., extracted
# from the Xcode 2.5 DMG payload) IS small enough to vendor — it's
# inert binaries, no SDK clutter.
!/prereqs/graphics-tools/

# Make outputs from in-tree builds
Quake/*.o
Quake/*.d
Quake/quakespasm
Quake/quakespasm.x86
Quake/quakespasm.x86_64
Quake/quakespasm.ppc

# Editor crud
.DS_Store
*.swp
*~

# Claude Code transient state
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Round v4 -- screenshot bank fetched back from each host via
# scripts/screenshot.sh. TGAs at 1024x768 are ~2.3 MB each; with 90 shots
# per host x 4 hosts that's ~800 MB per round. The host-side originals
# live in ~/Desktop/quakespasm-screens-<hostname>/ on each machine,
# which is the canonical store. Local copies are for review only.
/benchmarks/screenshots/
