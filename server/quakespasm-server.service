[Unit]
Description=QuakeSpasm dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quake
Group=quake
WorkingDirectory=/opt/quakespasm-server

# The console.
#
# NetQuake has no rcon, so the only way to change map or read status on a
# running server is its stdin. A plain redirect from a FIFO is no good: the
# server would see EOF and stop reading the moment a writer closed, so exactly
# one command would ever work.
#
# Opening the FIFO read-write on fd 3 and handing THAT to the server keeps a
# writer permanently attached from the server's own side, so the pipe never
# reaches EOF and stays usable for the life of the process. After that:
#
#     echo "map e1m2" > /run/quakespasm-server/console
#
# The player limit is the number after -dedicated. It cannot be set from
# server.cfg, because NetQuake fixes it before any config is read.
RuntimeDirectory=quakespasm-server
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/mkfifo -m 0600 /run/quakespasm-server/console
# -ip is NOT optional on Debian or Ubuntu, and getting it wrong looks like a
# working server that nobody can join.
#
# NetQuake's connect handshake has the server TELL the client which address to
# use for the game session, and net_udp.c derives that from gethostname()
# followed by gethostbyname(). Debian and Ubuntu ship an /etc/hosts line
# mapping the hostname to 127.0.1.1, so the server answers every query with
#
#     127.0.1.1:26000 UNNAMED start
#
# The client dutifully switches to 127.0.1.1, which on the client is ITSELF, so
# it connects to its own loopback, prints "Connection accepted", starts a local
# server and plays alone. Measured 2026-08-21: the client said it was connected
# while tcpdump on the server saw zero packets on 26000.
#
# EDIT THIS to the address players will actually reach the server on. It is
# both the bind address and the advertised one, so it has to be a real address
# of this machine, not 0.0.0.0. Verified working on a LAN with the server's own
# address: the query reply changed from 127.0.1.1:26000 to <address>:26000 and
# a PowerPC client then genuinely joined, taking the server from 0/8 to 1/8.
#
# It is deliberately EMPTY as shipped, and the server refuses to start until it
# is set. This unit used to ship `-ip 192.0.2.1`, which is TEST-NET-1 and
# reserved for documentation: no machine has that address, so a clean install
# bound to nothing and nobody could join. That is a worse failure than no value
# at all, because a placeholder that looks configured gets read straight past.
Environment=QS_IP=

ExecStart=/bin/sh -c 'case "$QS_IP" in \
      "") echo "quakespasm-server: QS_IP is not set. Edit Environment=QS_IP= in this unit and set it to the address players reach this machine on. Without it the server advertises 127.0.1.1 and every client silently plays alone. See README.md." >&2; exit 78 ;; \
      0.0.0.0|127.*) echo "quakespasm-server: QS_IP=$QS_IP is not reachable by anyone else. It is both the bind and the ADVERTISED address, so it has to be a real address of this machine." >&2; exit 78 ;; \
      192.0.2.*|198.51.100.*|203.0.113.*) echo "quakespasm-server: QS_IP=$QS_IP is a documentation address (TEST-NET, RFC 5737) and belongs to no machine. Set it to a real address of this machine." >&2; exit 78 ;; \
    esac; \
    exec 3<>/run/quakespasm-server/console; \
    exec /opt/quakespasm-server/quakespasm-server \
        -dedicated 8 \
        -ip "$QS_IP" \
        -basedir /opt/quakespasm-server \
        +exec server.cfg <&3'

Restart=on-failure
RestartSec=5s

# 78 is EX_CONFIG, which the guard above uses for "you have not set QS_IP".
# Without this the unit would restart-loop every 5 seconds forever on a
# misconfiguration that no amount of restarting will fix, and bury the one
# message that says what is wrong.
RestartPreventExitStatus=78

# The server is a 1996 UDP protocol with no authentication, reachable from the
# internet. Give it as little of the machine as it can run with.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictSUIDSGID=true
UMask=0077
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=true
ProtectClock=true
PrivateUsers=true

# Seccomp. @system-service is the standard allow-list for a long-running
# daemon; everything outside it returns EPERM rather than killing the process,
# so an exploit that reaches for execve or ptrace gets an error instead of a
# shell.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @cpu-emulation @debug @mount @swap @reboot @module
SystemCallErrorNumber=EPERM

# Bound the blast radius of a memory-exhaustion bug. These are generous for a
# game server carrying a handful of players and still stop one process taking
# the whole box down.
MemoryMax=1G
TasksMax=64
LimitNOFILE=1024
LimitCORE=0

# Quake writes saves and config back into the game directory, so that one path
# is the only writable thing it gets.
ReadWritePaths=/opt/quakespasm-server/id1

[Install]
WantedBy=multi-user.target
